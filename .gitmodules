# Git Submodules Configuration
#
# Submodules allow us to include external Git repositories as subdirectories within this project.
# They maintain their own commit history and can be updated independently.
#
# The 'rag_api' submodule links to the tt-librechat-rag repository, which provides
# RAG (Retrieval-Augmented Generation) API functionality for LibreChat.
# It is configured to follow the 'develop' branch when updating with `git submodule update --remote`.
#
# To initialize after cloning: git submodule update --init --recursive
# To update to latest: git submodule update --remote rag_api

[submodule "rag_api"]
	path = rag_api
	url = https://github.com/Deloitte-Australia/tt-librechat-rag.git
	branch = develop
