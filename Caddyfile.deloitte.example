# Local development with self-signed certificate
localhost {
    tls internal

    @adminStatic path /admin/assets/* /admin/favicon.ico
    handle @adminStatic {
        uri strip_prefix /admin
        reverse_proxy admin-panel:3000
    }

    @admin path /admin /admin/*
    handle @admin {
        reverse_proxy admin-panel:3000
    }

    handle {
        reverse_proxy api:3080
    }
}

# Run hostname in your terminal to find the correct hostname for your machine
YOURHOSTNAME.local {
    tls internal

    @adminStatic path /admin/assets/* /admin/favicon.ico
    handle @adminStatic {
        uri strip_prefix /admin
        reverse_proxy admin-panel:3000
    }

    @admin path /admin /admin/*
    handle @admin {
        reverse_proxy admin-panel:3000
    }

    handle {
        reverse_proxy api:3080
    }
}
