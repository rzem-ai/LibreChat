{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Manual testing suite",
  "description": "One suite file per epic. Collated into the testing-session Excel sheet by `npm run manual-tests:collate`.",
  "type": "object",
  "required": ["suite", "idPrefix", "tests"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "suite": {
      "type": "string",
      "minLength": 1,
      "description": "Epic name shown in the Test Suite column."
    },
    "idPrefix": {
      "type": "string",
      "pattern": "^[A-Z]+$",
      "description": "Prefix shared by every test id in this suite."
    },
    "tests": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/test" } }
  },
  "definitions": {
    "link": {
      "type": "object",
      "required": ["name", "url"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https://" }
      }
    },
    "step": {
      "type": "object",
      "required": ["action", "acceptanceCriteria"],
      "additionalProperties": false,
      "properties": {
        "action": { "type": "string", "minLength": 1, "description": "What the tester does." },
        "acceptanceCriteria": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "What the tester must observe after this action. May be empty for pure set-up steps."
        }
      }
    },
    "test": {
      "type": "object",
      "required": ["id", "goal", "dateUpdated", "author", "lastPr", "steps"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z]+-\\d{3,}$",
          "description": "Unique across all suites, e.g. SKILL-017."
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "description": "Short title: the purpose of the test."
        },
        "dateUpdated": {
          "type": "string",
          "pattern": "^\\d{2} (Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec) \\d{4}$",
          "description": "Human readable DD Mon YYYY, e.g. 02 Nov 2026."
        },
        "author": {
          "oneOf": [{ "$ref": "#/definitions/link" }, { "type": "null" }],
          "description": "Author of the last relevant PR. null only for tests migrated without a known PR."
        },
        "lastPr": {
          "oneOf": [{ "$ref": "#/definitions/link" }, { "type": "null" }],
          "description": "Last relevant PR (name is e.g. \"#1850\"). null only for tests migrated without a known PR."
        },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/step" } }
      }
    }
  }
}
