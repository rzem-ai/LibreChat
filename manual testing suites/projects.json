{
  "$schema": "./suite.schema.json",
  "suite": "Projects",
  "idPrefix": "PROJECTS",
  "tests": [
    {
      "id": "PROJECTS-001",
      "goal": "Confirm that a new project can be created",
      "dateUpdated": "03 Nov 2026",
      "author": { "name": "afulton_deloitte", "url": "https://github.com/afulton_deloitte" },
      "lastPr": {
        "name": "#1857",
        "url": "https://github.com/Deloitte-Australia/tt-librechat/pull/1857"
      },
      "steps": [
        {
          "action": "Open Projects.",
          "acceptanceCriteria": []
        },
        {
          "action": "Click Create Project.",
          "acceptanceCriteria": []
        },
        {
          "action": "Name it and save.",
          "acceptanceCriteria": ["The project is created and listed"]
        }
      ]
    },
    {
      "id": "PROJECTS-002",
      "goal": "Confirm that a chat can be started inside a project",
      "dateUpdated": "03 Nov 2026",
      "author": { "name": "afulton_deloitte", "url": "https://github.com/afulton_deloitte" },
      "lastPr": {
        "name": "#1857",
        "url": "https://github.com/Deloitte-Australia/tt-librechat/pull/1857"
      },
      "steps": [
        {
          "action": "Open a project.",
          "acceptanceCriteria": []
        },
        {
          "action": "Start a new chat from within it.",
          "acceptanceCriteria": ["The chat is scoped to the project"]
        }
      ]
    },
    {
      "id": "PROJECTS-003",
      "goal": "Confirm that a chat can be moved to a different project",
      "dateUpdated": "03 Nov 2026",
      "author": { "name": "afulton_deloitte", "url": "https://github.com/afulton_deloitte" },
      "lastPr": {
        "name": "#1857",
        "url": "https://github.com/Deloitte-Australia/tt-librechat/pull/1857"
      },
      "steps": [
        {
          "action": "Open a chat in a project.",
          "acceptanceCriteria": []
        },
        {
          "action": "Click the three dots and pick a different project.",
          "acceptanceCriteria": ["The chat moves to the other project"]
        }
      ]
    },
    {
      "id": "PROJECTS-004",
      "goal": "Confirm that a chat can be taken out of a project",
      "dateUpdated": "03 Nov 2026",
      "author": { "name": "afulton_deloitte", "url": "https://github.com/afulton_deloitte" },
      "lastPr": {
        "name": "#1857",
        "url": "https://github.com/Deloitte-Australia/tt-librechat/pull/1857"
      },
      "steps": [
        {
          "action": "Open a project-scoped chat.",
          "acceptanceCriteria": []
        },
        {
          "action": "Click \"Remove from project\" on the project chip.",
          "acceptanceCriteria": ["The chat is no longer in the project"]
        }
      ]
    },
    {
      "id": "PROJECTS-005",
      "goal": "Confirm that a project can be deleted without losing its chats",
      "dateUpdated": "03 Nov 2026",
      "author": { "name": "afulton_deloitte", "url": "https://github.com/afulton_deloitte" },
      "lastPr": {
        "name": "#1857",
        "url": "https://github.com/Deloitte-Australia/tt-librechat/pull/1857"
      },
      "steps": [
        {
          "action": "Delete a project that has scoped chats.",
          "acceptanceCriteria": []
        },
        {
          "action": "Open one of those chats.",
          "acceptanceCriteria": ["The project is deleted", "The chats are still available"]
        }
      ]
    },
    {
      "id": "PROJECTS-006",
      "goal": "Confirm that a project can be renamed",
      "dateUpdated": "03 Nov 2026",
      "author": { "name": "afulton_deloitte", "url": "https://github.com/afulton_deloitte" },
      "lastPr": {
        "name": "#1857",
        "url": "https://github.com/Deloitte-Australia/tt-librechat/pull/1857"
      },
      "steps": [
        {
          "action": "Select the options of a project.",
          "acceptanceCriteria": []
        },
        {
          "action": "Select \"Rename\" and enter a new name.",
          "acceptanceCriteria": ["The project shows the new name"]
        }
      ]
    }
  ]
}
