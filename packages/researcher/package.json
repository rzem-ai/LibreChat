{
  "name": "@librechat/researcher",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "description": "Research agents for LibreChat: jobs, sources, verification, feeds, scheduling and their panels",
  "repository": {
    "type": "git",
    "url": "https://github.com/LibreChat-AI/LibreChat"
  },
  "main": "dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./client": {
      "import": {
        "types": "./dist/client.d.mts",
        "default": "./dist/client.mjs"
      },
      "require": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsdown",
    "build:watch": "tsdown --watch",
    "test": "jest",
    "test:ci": "jest --ci",
    "build:server": "tsdown --filter server",
    "build:client": "tsdown --filter client",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@librechat/agents": "^4.0.1",
    "@librechat/api": "*",
    "@librechat/client": "*",
    "@librechat/data-schemas": "*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@tanstack/react-query": "^4.28.0",
    "axios": "^1.20.0",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.7.2",
    "i18next": "^24.2.2",
    "js-yaml": "^4.1.0",
    "librechat-data-provider": "*",
    "lucide-react": "^0.528.0",
    "mdast-util-directive": "^3.0.0",
    "mdast-util-from-markdown": "^2.0.1",
    "mdast-util-gfm": "^3.0.0",
    "mdast-util-math": "^3.0.0",
    "micromark": "^4.0.0",
    "micromark-extension-directive": "^3.0.1",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-extension-llm-math": "^3.1.0",
    "mongoose": "^8.24.1",
    "react": "^18.2.0 || ^19.1.0",
    "react-dom": "^18.2.0 || ^19.1.0",
    "react-i18next": "^15.4.0",
    "react-router-dom": "^7.18.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.5",
    "@babel/preset-react": "^7.22.15",
    "@babel/preset-typescript": "^7.21.0",
    "@librechat/agents": "^4.0.1",
    "@librechat/api": "*",
    "@librechat/client": "*",
    "@librechat/data-schemas": "*",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.2",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.12.4",
    "@types/react": "^18.2.11",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-junit": "^17.0.0",
    "librechat-data-provider": "*",
    "mongodb-memory-server": "^11.0.1",
    "rimraf": "^6.1.3",
    "tsdown": "0.22.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "node-html-markdown": "^2.0.0",
    "zod-to-json-schema": "^3.24.1"
  }
}
