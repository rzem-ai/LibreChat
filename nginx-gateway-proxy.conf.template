# Map Authorization: ****** → $token for Azure OpenAI proxy
map $http_authorization $token {
    ~*^Bearer\s+(.+)$  $1;
    default             "";
}

# Single source of truth for all providers proxied below (Anthropic, Azure OpenAI,
# Bedrock): matches Anthropic's own 32MB total-request ceiling, which is also
# generous enough for the others' smaller native per-item limits. Set once at this
# http-level scope (this file is included inside the base image's http{} block via
# /etc/nginx/templates) so it can't drift out of sync between the server blocks below.
client_max_body_size 32M;

# Deloitte Custom Change: prefer LibreChat's resolved per-user identity token. Retain the local API-key
# path as a fallback for non-OIDC development sessions.
map $http_x_id_token $gateway_identity_token {
    default $http_x_id_token;
    ""      $token;
}

map $http_x_id_token $anthropic_identity_token {
    default $http_x_id_token;
    ""      $http_x_api_key;
}
# ===========================================
# Anthropic Gateway Proxy (port 8080)
# Translates x-api-key → x-id-token
# ===========================================
server {
    listen 8080;

    location / {
        proxy_set_header x-id-token $anthropic_identity_token;
        proxy_set_header anthropic-version "2023-06-01";
        proxy_set_header Content-Type $http_content_type;
        proxy_set_header Host us-anthropic-exp.ctk.au.deloitte.com;
        proxy_set_header x-api-key "";

        proxy_pass https://us-anthropic-exp.ctk.au.deloitte.com;
        proxy_ssl_server_name on;

        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        proxy_connect_timeout 10s;
    }
}

# ===========================================
# Azure OpenAI and Bedrock Gateway Proxy (port 8081)
# Used by RAG API for embeddings and Bedrock model invocations
# Translates Authorization: ****** → x-id-token
# ===========================================
server {
    listen 8081;

     location /model {
         proxy_set_header x-id-token $http_x_id_token;
         proxy_set_header Authorization "";
         proxy_set_header Content-Type $http_content_type;
         proxy_set_header Host ${BEDROCK_REVERSE_PROXY};

         proxy_pass https://${BEDROCK_REVERSE_PROXY};
         proxy_ssl_server_name on;

         proxy_buffering off;
         proxy_cache off;
         proxy_read_timeout 300s;
         proxy_connect_timeout 10s;
     }

    location /azure-au/ {
        proxy_set_header x-id-token $gateway_identity_token;
        proxy_set_header Authorization "";
        proxy_set_header Content-Type $http_content_type;
        proxy_set_header Host ${AZURE_OPENAI_HOST};

        proxy_pass https://${AZURE_OPENAI_HOST}/openai/v1/;
        proxy_ssl_server_name on;

        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        proxy_connect_timeout 10s;
    }

    location /azure-global/ {
        proxy_set_header x-id-token $gateway_identity_token;
        proxy_set_header Authorization "";
        proxy_set_header Content-Type $http_content_type;
        proxy_set_header Host ${AZURE_OPENAI_GLOBAL_HOST};

        proxy_pass https://${AZURE_OPENAI_GLOBAL_HOST}/openai/v1/;
        proxy_ssl_server_name on;

        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        proxy_connect_timeout 10s;
    }

    location / {
        proxy_set_header x-id-token $gateway_identity_token;
        proxy_set_header Authorization "";
        proxy_set_header Content-Type $http_content_type;
        proxy_set_header Host ${AZURE_OPENAI_HOST};

        proxy_pass https://${AZURE_OPENAI_HOST}/openai/v1/;
        proxy_ssl_server_name on;

        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        proxy_connect_timeout 10s;
    }
}
