# Map Authorization: ****** → $token for Azure OpenAI proxy
map $http_authorization $token {
    ~*^Bearer\s+(.+)$  $1;
    default             "";
}

# ===========================================
# Anthropic Gateway Proxy (port 8080)
# Translates x-api-key → x-id-token
# ===========================================
server {
    listen 8080;
    client_max_body_size 25M;

    location / {
        proxy_set_header x-id-token $http_x_api_key;
        proxy_set_header anthropic-version "2023-06-01";
        proxy_set_header Content-Type $http_content_type;
        proxy_set_header Host us-anthropic-exp.ctk.au.deloitte.com;
        proxy_set_header x-api-key "";

        proxy_pass https://us-anthropic-exp.ctk.au.deloitte.com;
        proxy_ssl_server_name on;

        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        proxy_connect_timeout 10s;
    }
}

# ===========================================
# Azure OpenAI and Bedrock Gateway Proxy (port 8081)
# Used by RAG API for embeddings and Bedrock model invocations
# Translates Authorization: ****** → x-id-token
# ===========================================
server {
    listen 8081;
    client_max_body_size 25M;

     location /model {
         proxy_set_header x-id-token $http_x_id_token;
         proxy_set_header Authorization "";
         proxy_set_header Content-Type $http_content_type;
         proxy_set_header Host ${BEDROCK_REVERSE_PROXY};

         proxy_pass https://${BEDROCK_REVERSE_PROXY};
         proxy_ssl_server_name on;

         proxy_buffering off;
         proxy_cache off;
         proxy_read_timeout 300s;
         proxy_connect_timeout 10s;
     }

    location /azure-au/ {
        proxy_set_header x-id-token $token;
        proxy_set_header Authorization "";
        proxy_set_header Content-Type $http_content_type;
        proxy_set_header Host ${AZURE_OPENAI_HOST};

        proxy_pass https://${AZURE_OPENAI_HOST}/openai/v1/;
        proxy_ssl_server_name on;

        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        proxy_connect_timeout 10s;
    }

    location /azure-global/ {
        proxy_set_header x-id-token $token;
        proxy_set_header Authorization "";
        proxy_set_header Content-Type $http_content_type;
        proxy_set_header Host ${AZURE_OPENAI_GLOBAL_HOST};

        proxy_pass https://${AZURE_OPENAI_GLOBAL_HOST}/openai/v1/;
        proxy_ssl_server_name on;

        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        proxy_connect_timeout 10s;
    }

    location / {
        proxy_set_header x-id-token $token;
        proxy_set_header Authorization "";
        proxy_set_header Content-Type $http_content_type;
        proxy_set_header Host ${AZURE_OPENAI_HOST};

        proxy_pass https://${AZURE_OPENAI_HOST}/openai/v1/;
        proxy_ssl_server_name on;

        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        proxy_connect_timeout 10s;
    }
}
